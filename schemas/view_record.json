      "source_schema":        { "type": ["string", "null"] },
      "source_table":         { "type": ["string", "null"] },
      "source_column":        { "type": ["string", "null"] },
      "source_alias":         { "type": ["string", "null"] },
      "source_role":          { "type": ["string", "null"],
                                "enum": ["value", "join", "condition", null] },
      "transformation_logic": { "type": ["string", "null"] }
    },
    "required": [
      "target_table",
      "target_column",
      "source_schema",
      "source_table",
      "source_column",
      "source_alias",
      "source_role",
      "transformation_logic"
    ],
    "additionalProperties": false
  }
